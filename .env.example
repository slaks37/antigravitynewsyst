# Database Configuration
# In production or local Docker: postgresql://user:password@localhost:5432/newsystem_db
DATABASE_URL=postgresql://newsystem:newsystem_secret_password@localhost:5432/newsystem_db

# Next.js Application
NEXT_PUBLIC_SITE_URL=https://newsystem.space
NEXT_PUBLIC_CMS_URL=https://cms.newsystem.space
NEXT_PUBLIC_APP_NAME="NewSystem"
NEXT_PUBLIC_APP_TAGLINE="One System. Every Process. Smarter Business."

# CMS Authentication
CMS_JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
CMS_SESSION_DURATION=604800 # 7 days in seconds

# Scheduled Publishing & Cron
CRON_SECRET=secure_cron_secret_token_here

# Content Ingestion & Automation API (Blog Auto-posting / MCP / Webhooks / n8n / Make)
EDITORIAL_INGEST_API_KEY=secure_editorial_ingestion_api_key_here
BLOG_AUTOMATION_API_KEY=secure_blog_automation_api_key_here

# AI Editorial Assistant (Google Gemini API / OpenAI compatible)
GEMINI_API_KEY=
AI_PROVIDER_MODEL=gemini-2.0-flash

# Media Storage (Optional S3 Configuration; defaults to local storage if empty)
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_PREFIX=

# Analytics & Monitoring (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_COOKIE_CONSENT_ENABLED=true

# Email Notification Provider (Optional)
EMAIL_PROVIDER=console # console | resend | sendgrid | smtp
EMAIL_FROM=notifications@newsystem.space
NOTIFICATION_EMAIL=stefen@newsystem.space
RESEND_API_KEY=
